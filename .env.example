# Copy to .env to override defaults. The app runs fine with no .env at all.
# SECRET_KEY=generate-a-real-one-for-anything-beyond-a-laptop
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1

# Email. With no settings, every message's plain text prints to the dev
# server's terminal (config.email_backends.ReadableConsoleEmailBackend).
# For real delivery, switch to SMTP and fill in your provider's details:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-username
# EMAIL_HOST_PASSWORD=your-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=The ThoughtTronix Store <no-reply@thoughttronix.example>
